{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Temporal Worker",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/worker.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Debug: Worker + API",
      "configurations": ["Debug: Temporal Worker", "Debug: FastAPI"],
      "stopAll": true
    }
  ]
}
